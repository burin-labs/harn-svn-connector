import {
  paginate_cursor,
  rate_limit_token_bucket,
  verify_hmac_signature,
} from "std/connectors/shared"

const PROVIDER_ID = "svn"

const STATE_KEY = "harn-svn-connector.state"

const DEFAULT_API_BASE_URL = "https://svn.example.com"

const ENV_PREFIX = "SVN"

const SIGNATURE_HEADER = "x-harn-svn-signature"

const EVENT_HEADER = "x-svn-event"

const SUPPORTED_EVENTS = ["commit", "branch", "tag", "property_change"]

const DELIVERY_HEADERS = ["x-svn-revision", "x-request-id"]

// SVN is an inbound-first connector (post-commit hook + polling revision scanner). Its outbound
// surface is intentionally minimal and read-only: Subversion has no pull-request / issue / commit-
// status write API, so the previously copied gitea-shaped stubs were removed. The remaining methods
// read revision/log and repository info over the configured SVN HTTP (DAV) endpoint; use the
// generic `api.request` / `paginate` escape hatches for anything else the server exposes.
const OUTBOUND_METHODS = [
  "api.request",
  "paginate",
  "repository.info",
  "revision.get",
  "revision.log",
]

/** Return this connector's provider id. */
pub fn provider_id() {
  return PROVIDER_ID
}

/** Return supported trigger kinds. */
pub fn kinds() {
  return ["webhook", "poll"]
}

/** Return the normalized payload schema metadata. */
pub fn payload_schema() {
  return {
    harn_schema_name: "SvnEventPayload",
    json_schema: {
      type: "object",
      required: ["event", "repository", "actor", "raw"],
      additionalProperties: true,
      properties: {
        event: {type: "string"},
        action: {type: ["string", "null"]},
        repository: {type: ["object", "null"], additionalProperties: true},
        actor: {type: ["object", "null"], additionalProperties: true},
        resource: {type: ["object", "null"], additionalProperties: true},
        raw: {type: "object"},
      },
    },
  }
}

/** Initialize connector state with orchestrator context. */
pub fn init(harness: Harness, ctx: any = nil) {
  const next = __state(harness.runtime) + {initialized: true, ctx: ctx ?? {}}
  __set_state(harness.runtime, next)
  return next
}

/** Activate configured trigger bindings. */
pub fn activate(harness: Harness, bindings: any = []) {
  let by_id = {}
  let seen_paths = {}
  for binding in bindings ?? [] {
    const binding_id = (binding?.binding_id ?? binding?.id ?? "binding-")
      + to_string(len(by_id.keys()))
    const path = binding?.path ?? binding?.match?.path
    if path != nil && path != "" {
      if seen_paths.get(path) {
        return __err(
          "activation",
          PROVIDER_ID + " connector path `" + path + "` is configured by multiple bindings",
        )
      }
      seen_paths[path] = true
    }
    by_id[binding_id] = binding + {binding_id: binding_id}
  }
  const next = __state(harness.runtime) + {bindings: by_id, active: true}
  __set_state(harness.runtime, next)
  return {provider: PROVIDER_ID, bindings: len(by_id.keys())}
}

/**
 * Clear connector lifecycle state.
 *
 * @host_only — this entry point wipes cached binding state including secrets resolved during
 * activate(). It must only be invoked by the orchestrator's connector lifecycle, never from
 * untrusted pipeline nodes or external callers. Full caller-identity gating is tracked as a
 * host responsibility.
 */
pub fn shutdown(harness: Harness) {
  harness.runtime.store_delete(STATE_KEY)
  return {provider: PROVIDER_ID, active: false}
}

@complexity(allow)
/** Verify and normalize an inbound webhook request. */
pub fn normalize_inbound(harness: Harness, raw: any) {
  const headers = raw?.headers ?? {}
  // Resolve the signed surface (raw bytes preferred over body_text) before parsing JSON so an
  // unsigned/oversized payload cannot exhaust the parser ahead of signature verification.
  const signed = __signed_surface(raw)
  if is_err(signed) {
    return __reject_err(unwrap_err(signed))
  }
  const body_text = unwrap(signed)
  const verified = __verify_signature(
    {env: harness.env, runtime: harness.runtime},
    raw,
    headers,
    body_text,
  )
  if is_err(verified) {
    return __reject_err(unwrap_err(verified))
  }
  const signature_status = unwrap(verified)
  const parsed = try {
    json_parse(body_text)
  }
  if is_err(parsed) {
    return __reject(400, "invalid_json", PROVIDER_ID + " payload body is not valid JSON")
  }
  const payload = unwrap(parsed)
  const base_event = __base_event(payload, headers)
  if base_event == nil || base_event == "" {
    return __reject(
      400,
      "missing_event",
      "missing " + PROVIDER_ID + " event header or payload event",
    )
  }
  if !__supports_event(base_event) {
    return __reject(
      400,
      "unsupported_event",
      "unsupported " + PROVIDER_ID + " event `" + to_string(base_event) + "`",
    )
  }
  const event = __build_event(base_event, payload, raw, headers, signature_status, body_text)
  return {type: "event", event: event}
}

/** Run one polling tick for providers that support polling. */
pub fn poll_tick(harness: Harness, ctx: any = nil) {
  const cursor = ctx?.cursor ?? ctx?.state?.last_revision
  return {
    type: "batch",
    events: [],
    cursor: cursor,
    state: {last_revision: cursor, repository_url: ctx?.repository_url},
  }
}

@complexity(allow)
/** Dispatch a supported outbound helper method. */
pub fn call(harness: Harness, method: any, args: any = {}) {
  if !contains(OUTBOUND_METHODS, method) {
    return __err(
      "method_not_found",
      PROVIDER_ID + " connector does not implement outbound method `" + method + "`",
    )
  }
  if method == "api.request" {
    return __api_request(harness, args ?? {})
  }
  if method == "paginate" {
    return __paginate(harness, args ?? {})
  }
  if method == "repository.info" {
    return __repository_info(harness, args ?? {})
  }
  if method == "revision.get" {
    return __revision_get(harness, args ?? {})
  }
  return __revision_log(harness, args ?? {})
}

fn __state(runtime: HarnessRuntime) {
  return runtime.store_get(STATE_KEY)
    ?? {initialized: false, active: false, bindings: {}, ctx: {}, rate_limit_buckets: {}}
}

fn __set_state(runtime: HarnessRuntime, state: any) {
  runtime.store_set(STATE_KEY, state)
  return state
}

fn __err(code: any, message: any) {
  return Err({code: code, message: message})
}

fn __err_with(code: any, message: any, extra: any) {
  return Err({code: code, message: message} + (extra ?? {}))
}

fn __reject(status: any, code: any, message: any) {
  return {
    type: "reject",
    reject: {
      status: status,
      body: json_stringify({error: code, message: message}),
      content_type: "application/json",
    },
  }
}

fn __reject_err(err: any) {
  const code = err?.code ?? "rejected"
  const status = if code == "invalid_signature" || code == "missing_signature" {
    401
  } else if code == "missing_binding_id" || code == "missing_body"
    || code
      == "invalid_body" {
    400
  } else {
    400
  }
  return __reject(status, code, err?.message ?? "request rejected")
}

fn __header(headers: any, name: any) {
  const wanted = lowercase(name)
  for entry in (headers ?? {}).entries() {
    if lowercase(trim(to_string(entry.key))) == wanted {
      return trim(to_string(entry.value))
    }
  }
  return nil
}

fn __base_event(payload: any, headers: any) {
  const from_header = __header(headers, EVENT_HEADER)
  if from_header != nil && from_header != "" {
    return to_string(from_header)
  }
  return payload?.event ?? payload?.event_name ?? payload?.object_kind ?? payload?.type
    ?? payload?.action
}

fn __supports_event(event: any) {
  if contains(SUPPORTED_EVENTS, event) {
    return true
  }
  const normalized = __normalize_kind(event)
  // Match either an exact normalized name or a fully-qualified subkind. A bare prefix is
  // rejected so e.g. "commit_x" never spoofs "commit".
  for supported in SUPPORTED_EVENTS {
    const supported_norm = __normalize_kind(supported)
    if normalized == supported_norm || starts_with(normalized, supported_norm + ".") {
      return true
    }
  }
  return false
}

fn __verify_signature(
  harness: {env: HarnessEnv, runtime: HarnessRuntime},
  raw: any,
  headers: any,
  body_text: any,
) {
  const binding_id = raw?.metadata?.binding_id ?? raw?.binding_id
  if binding_id == nil || trim(to_string(binding_id)) == "" {
    return __err(
      "missing_binding_id",
      "request did not include a binding_id; cannot resolve secret",
    )
  }
  const secret = __signing_secret({env: harness.env, runtime: harness.runtime}, raw)
  // Fail-closed: refuse delivery when no signing secret is configured for this binding.
  if secret == nil || trim(to_string(secret)) == "" {
    return __err("missing_signature", "no signing secret configured for this binding")
  }
  const provided = __header(headers, SIGNATURE_HEADER)
  if provided == nil || provided == "" {
    return __err(
      "missing_signature",
      SIGNATURE_HEADER + " header missing but a signing_secret is configured",
    )
  }
  if verify_hmac_signature(body_text, to_string(provided), to_string(secret), "sha256") {
    return Ok("signed")
  }
  return __err(
    "invalid_signature",
    SIGNATURE_HEADER + " did not match the configured signing_secret",
  )
}

/**
 * Resolve the byte surface that was signed. Prefer raw.body_text when present; otherwise
 * base64-decode raw.body_base64. Reject when neither field is present so we never HMAC over
 * "" by accident.
 */
fn __signed_surface(raw: any) {
  const body_text = raw?.body_text ?? raw?.body
  if body_text != nil {
    return Ok(to_string(body_text))
  }
  const body_b64 = raw?.body_base64
  if body_b64 != nil && trim(to_string(body_b64)) != "" {
    const decoded = try {
      base64_decode(to_string(body_b64))
    }
    if is_err(decoded) {
      return __err("invalid_body", "body_base64 is not valid base64")
    }
    return Ok(unwrap(decoded))
  }
  return __err("missing_body", "request has neither body_text nor body_base64")
}

/**
 * Resolve the signing secret from trusted sources only: orchestrator ctx, the per-binding
 * state seeded via activate(), or the process env. raw.* fields are attacker-controlled and
 * must not feed the HMAC key. binding_id is required upstream; we refuse the single-binding
 * fallback so that secrets are never resolved without an explicit binding pointer.
 */
fn __signing_secret(harness: {env: HarnessEnv, runtime: HarnessRuntime}, raw: any) {
  const state = __state(harness.runtime)
  const ctx_secret = state?.ctx?.signing_secret ?? state?.ctx?.secrets?.signing_secret
  if ctx_secret != nil && trim(to_string(ctx_secret)) != "" {
    return to_string(ctx_secret)
  }
  const binding_id = raw?.metadata?.binding_id ?? raw?.binding_id
  if binding_id == nil || trim(to_string(binding_id)) == "" {
    return nil
  }
  const bindings = state?.bindings ?? {}
  const binding = bindings.get(binding_id)
  const bound = binding?.signing_secret ?? binding?.secrets?.signing_secret
    ?? binding?.config?.signing_secret
  if bound != nil && trim(to_string(bound)) != "" {
    return to_string(bound)
  }
  const env_secret_result = try {
    harness.env.get(ENV_PREFIX + "_SIGNING_SECRET")
  }
  if !is_err(env_secret_result) {
    const env_secret = unwrap(env_secret_result)
    if env_secret != nil && trim(to_string(env_secret)) != "" {
      return to_string(env_secret)
    }
  }
  return nil
}

@complexity(allow)
fn __build_event(
  base_event: any,
  payload: any,
  raw: any,
  headers: any,
  signature_status: any,
  body_text: any,
) {
  const kind = __event_kind(base_event, payload)
  return {
    kind: kind,
    occurred_at: raw?.occurred_at ?? payload?.updated_at ?? payload?.created_at
      ?? payload?.timestamp,
    dedupe_key: __dedupe_key(base_event, payload, raw, headers, body_text),
    signature_status: __signature_status(signature_status),
    payload: {
      event: base_event,
      action: payload?.action,
      repository: __repository(payload),
      actor: __actor(payload),
      resource: __resource(payload),
      raw: payload,
    },
    headers: __normalized_headers(headers),
  }
}

fn __signature_status(status: any) {
  if status == "signed" || status == "verified" {
    return {state: "verified"}
  }
  return {state: "unsigned"}
}

fn __event_kind(base_event: any, payload: any) {
  const normalized = __normalize_kind(base_event)
  const action = payload?.action ?? payload?.pullrequest?.state
    ?? payload?.object_attributes?.action
  if action == nil || action == "" || contains(normalized, ".") {
    return normalized
  }
  return normalized + "." + __normalize_kind(action)
}

fn __normalize_kind(value: any) {
  return lowercase(replace(replace(to_string(value), ":", "."), " ", "_"))
}

fn __repository(payload: any) {
  const repo = payload?.repository ?? payload?.repo ?? {}
  return {
    id: repo?.id ?? repo?.uuid,
    name: repo?.name,
    full_name: repo?.full_name ?? repo?.path_with_namespace ?? repo?.canonical_name,
    url: repo?.html_url ?? repo?.web_url ?? repo?.links?.html?.href ?? repo?.url,
  }
}

fn __actor(payload: any) {
  const actor = payload?.sender ?? payload?.user ?? payload?.actor ?? payload?.pusher ?? {}
  return {
    id: actor?.id ?? actor?.uuid,
    username: actor?.login ?? actor?.username ?? actor?.nickname ?? actor?.canonical_name,
    name: actor?.name ?? actor?.display_name,
    email: actor?.email,
  }
}

fn __resource(payload: any) {
  return payload?.pull_request ?? payload?.pullrequest ?? payload?.issue ?? payload?.comment
    ?? payload?.release
    ?? payload?.object_attributes
    ?? {
      revision: payload?.revision,
      changed_paths: payload?.changed_paths,
      commits: payload?.commits,
    }
}

fn __dedupe_key(base_event: any, payload: any, raw: any, headers: any, body_text: any) {
  // Trust only the host-set delivery header — payload?.id / .uuid / .delivery_id / .revision
  // are attacker-controlled and would let a sender either suppress replay protection or evade
  // it at will.
  for header in DELIVERY_HEADERS {
    const value = __header(headers, header)
    if value != nil && value != "" {
      return PROVIDER_ID + ":" + __normalize_kind(base_event) + ":" + to_string(value)
    }
  }
  const binding_id = raw?.metadata?.binding_id ?? raw?.binding_id ?? ""
  const received_at = raw?.received_at ?? raw?.occurred_at ?? ""
  const body_b64 = raw?.body_base64 ?? body_text
  return PROVIDER_ID + ":" + __normalize_kind(base_event) + ":"
    + sha256(to_string(body_b64) + "|" + to_string(received_at) + "|" + to_string(binding_id))
}

fn __normalized_headers(headers: any) {
  let normalized = {}
  const event = __header(headers, EVENT_HEADER)
  if event != nil {
    normalized[EVENT_HEADER] = event
  }
  const signature = __header(headers, SIGNATURE_HEADER)
  if signature != nil {
    normalized[SIGNATURE_HEADER] = signature
  }
  for header in DELIVERY_HEADERS {
    const value = __header(headers, header)
    if value != nil {
      normalized[header] = value
    }
  }
  return normalized
}

@complexity(allow)
fn __outbound_config(env: HarnessEnv, args: any) {
  const env_base = ENV_PREFIX + "_API_BASE_URL"
  const env_token = ENV_PREFIX + "_TOKEN"
  const api_base_url = args?.api_base_url ?? env.get_or(env_base, DEFAULT_API_BASE_URL)
  // F11: only treat an explicit access_token / token as Bearer credentials. Do NOT alias
  // app_password or personal_access_token into Bearer for SVN — that's wrong for HTTP Basic
  // servers and would leak the password to a misconfigured endpoint.
  const access_token = args?.access_token ?? args?.token ?? args?.secrets?.access_token
    ?? env.get(env_token)
  return Ok({api_base_url: to_string(api_base_url), access_token: access_token})
}

/**
 * Build the Authorization header for an SVN-style request. SVN does not use Bearer tokens
 * natively; we prefer HTTP Basic when `username` (or env $SVN_USERNAME) and `password`
 * (or env $SVN_PASSWORD) are present, and only attach Bearer when the caller passed an
 * explicit `access_token` / `token`.
 */
fn __authorization_header(env: HarnessEnv, args: any, cfg: any) {
  const username = args?.username ?? args?.secrets?.username
    ?? env.get(ENV_PREFIX + "_USERNAME")
  const password = args?.password ?? args?.secrets?.password
    ?? env.get(ENV_PREFIX + "_PASSWORD")
  if username != nil && trim(to_string(username)) != "" && password != nil
    && trim(to_string(password))
      != "" {
    return "Basic " + base64_encode(to_string(username) + ":" + to_string(password))
  }
  if cfg.access_token != nil && trim(to_string(cfg.access_token)) != "" {
    return "Bearer " + to_string(cfg.access_token)
  }
  return nil
}

fn __rate_limit_config(runtime: HarnessRuntime, args: any) {
  const direct = args?.rate_limit
  if direct != nil {
    return direct
  }
  const state = __state(runtime)
  const binding_id = args?.binding_id ?? args?.metadata?.binding_id
  if binding_id != nil {
    const binding = state?.bindings?.get(binding_id)
    const from_binding = binding?.rate_limit ?? binding?.config?.rate_limit
    if from_binding != nil {
      return from_binding
    }
  }
  return state?.ctx?.rate_limit
}

fn __rate_limit_scope(args: any, config: any) {
  return config?.scope_key ?? args?.rate_limit_scope ?? args?.repository_url ?? args?.binding_id
    ?? "default"
}

fn __rate_limit_acquire(harness: {clock: HarnessClock, runtime: HarnessRuntime}, args: any) {
  const config = __rate_limit_config(harness.runtime, args)
  if config == nil {
    return Ok({allowed: true, retry_after_ms: 0})
  }
  const scope = __rate_limit_scope(args, config)
  const state = __state(harness.runtime)
  let buckets = state?.rate_limit_buckets ?? {}
  const result = rate_limit_token_bucket(harness.clock, buckets.get(scope), config, nil)
  buckets[scope] = result.state
  __set_state(harness.runtime, state + {rate_limit_buckets: buckets})
  if !result.allowed {
    return __err_with(
      "rate_limited",
      PROVIDER_ID + " outbound rate limit exhausted; retry in " + to_string(result.retry_after_ms)
        + "ms",
      {retry_after_ms: result.retry_after_ms, scope: scope},
    )
  }
  return Ok({allowed: true, retry_after_ms: 0})
}

fn __int_header(headers: any, name: any) {
  const value = __header(headers, name)
  if value == nil || value == "" {
    return nil
  }
  const parsed = try {
    to_int(value)
  }
  if is_ok(parsed) {
    return unwrap(parsed)
  }
  return nil
}

fn __retry_after_ms(headers: any) {
  const value = __header(headers, "retry-after")
  if value == nil || value == "" {
    return nil
  }
  const secs = try {
    to_int(value)
  }
  if is_ok(secs) {
    return unwrap(secs) * 1000
  }
  return nil
}

fn __response_rate_limit(headers: any) {
  return {
    limit: __int_header(headers, "x-ratelimit-limit"),
    remaining: __int_header(headers, "x-ratelimit-remaining"),
    reset: __int_header(headers, "x-ratelimit-reset"),
    retry_after_ms: __retry_after_ms(headers),
  }
}

@complexity(allow)
fn __api_request(harness: Harness, args: any) {
  const config = __outbound_config(harness.env, args ?? {})
  if is_err(config) {
    return config
  }
  const cfg = unwrap(config)
  const permit = __rate_limit_acquire({clock: harness.clock, runtime: harness.runtime}, args ?? {})
  if is_err(permit) {
    return permit
  }
  const method = uppercase(to_string(args?.method ?? "GET"))
  const path = args?.path ?? args?.url_path ?? ""
  const url_result = __api_url(cfg.api_base_url, path)
  if is_err(url_result) {
    return url_result
  }
  const url = unwrap(url_result)
  // F2: refuse to attach Authorization over plaintext http://, regardless of how it was
  // configured, so we never leak Basic/Bearer credentials in cleartext.
  const is_plaintext = starts_with(to_string(cfg.api_base_url ?? ""), "http://")
  let options = {headers: {Accept: "application/json"}, retry: {max: 0, backoff_ms: 0}}
  const auth_header = __authorization_header(harness.env, args ?? {}, cfg)
  if auth_header != nil {
    if is_plaintext {
      return __err(
        "insecure_transport",
        PROVIDER_ID + " refuses to attach Authorization over plaintext http://; configure https://",
      )
    }
    options.headers["Authorization"] = auth_header
  }
  if args?.body != nil {
    options["body"] = json_stringify(args.body)
    options.headers["Content-Type"] = "application/json"
  }
  const response_result = try {
    harness.net.request(method, url, options)
  }
  if is_err(response_result) {
    return __err("transport", to_string(unwrap_err(response_result)))
  }
  const response = unwrap(response_result)
  const rate_limit = __response_rate_limit(response.headers ?? {})
  if response.status < 200 || response.status >= 300 {
    return __err_with(
      "transport",
      PROVIDER_ID + " API request failed with status " + to_string(response.status),
      {
        status: response.status,
        headers: response.headers,
        body: response.body,
        rate_limit: rate_limit,
      },
    )
  }
  const raw_body = response.body ?? ""
  if trim(raw_body) == "" {
    return {status: response.status, headers: response.headers, body: nil, rate_limit: rate_limit}
  }
  const parsed = try {
    json_parse(raw_body)
  }
  if is_err(parsed) {
    return __err_with(
      "invalid_response",
      PROVIDER_ID + " API returned invalid JSON",
      {status: response.status, headers: response.headers, body: raw_body, rate_limit: rate_limit},
    )
  }
  return {
    status: response.status,
    headers: response.headers,
    body: unwrap(parsed),
    rate_limit: rate_limit,
  }
}

@complexity(allow)
fn __paginate(harness: Harness, args: any) {
  const cursor_param = args?.cursor_param ?? "cursor"
  const cursor_path = args?.cursor_path ?? "/next_cursor"
  const items_path = args?.items_path
  const max_pages = args?.max_pages ?? 100
  const initial_cursor = args?.initial_cursor
  const request_args = args ?? {}
  const initial_path = request_args?.path ?? ""
  const fetch_fn = { _url, cursor ->
    const target_path = if cursor == nil {
      initial_path
    } else {
      __append_query(initial_path, cursor_param, to_string(cursor))
    }
    const response = __api_request(
      harness,
      request_args + {method: request_args?.method ?? "GET", path: target_path},
    )
    if is_err(response) {
      throw unwrap_err(response)
    }
    return response.body ?? {}
  }
  const attempt = try {
    paginate_cursor(
      initial_path,
      fetch_fn,
      cursor_path,
      {max_pages: max_pages, items_path: items_path, initial_cursor: initial_cursor},
    )
  }
  if is_err(attempt) {
    const err = unwrap_err(attempt)
    return __err_with(err?.code ?? "paginate_failed", err?.message ?? "paginate failed", err ?? {})
  }
  return unwrap(attempt)
}

fn __append_query(target: any, key: any, value: any) {
  const separator = if contains(target, "?") {
    "&"
  } else {
    "?"
  }
  return target + separator + url_encode(key) + "=" + url_encode(value)
}

/**
 * SSRF defence: refuse absolute-URL paths so the configured api_base_url (and any attached
 * Authorization header) cannot be redirected to attacker-chosen hosts. Callers must pass a
 * relative path; absolute URLs return Err.
 */
fn __api_url(api_base_url: any, path: any) {
  const base = trim(to_string(api_base_url))
  const path_str = to_string(path ?? "")
  if starts_with(path_str, "http://") || starts_with(path_str, "https://") {
    return __err(
      "invalid_path",
      PROVIDER_ID + " api request path must be relative; absolute URLs are rejected",
    )
  }
  const prefix = if ends_with(base, "/") {
    base[0:len(base) - 1]
  } else {
    base
  }
  const suffix = if starts_with(path_str, "/") {
    path_str
  } else {
    "/" + path_str
  }
  return Ok(prefix + suffix)
}

/**
 * Resolve the repository-relative path to read. SVN servers expose a repository at a base URL;
 * callers pass `repo_path` (e.g. "/trunk") to scope a read, defaulting to the repository root.
 */
fn __svn_repo_path(args: any) {
  const repo_path = args?.repo_path ?? args?.path_in_repo ?? ""
  const trimmed = trim(to_string(repo_path))
  if trimmed == "" {
    return ""
  }
  if starts_with(trimmed, "/") {
    return trimmed
  }
  return "/" + trimmed
}

/**
 * Read Subversion repository info (root, latest/youngest revision) over the configured SVN HTTP
 * (DAV) endpoint. Read-only; SVN has no outbound write API in this connector's scope. Override the
 * exact path with `path`.
 */
fn __repository_info(harness: Harness, args: any) {
  const path = args?.path ?? ("/info" + __svn_repo_path(args))
  return __api_request(harness, args + {method: "GET", path: path})
}

/**
 * Read a single Subversion revision (`svn log -r <rev>` / `svn info -r <rev>` semantics) over the
 * configured SVN HTTP endpoint. Required arg: `revision`. Read-only. Override the path with `path`.
 */
fn __revision_get(harness: Harness, args: any) {
  const revision = args?.revision ?? args?.rev
  if revision == nil || trim(to_string(revision)) == "" {
    return __err("invalid_args", "revision.get requires revision")
  }
  const path = args?.path
    ?? ("/revisions/" + url_encode(to_string(revision)) + __svn_repo_path(args))
  return __api_request(harness, args + {method: "GET", path: path})
}

/**
 * Read a Subversion revision log range (`svn log` semantics) over the configured SVN HTTP
 * endpoint. Optional args: `from_revision` / `to_revision` to bound the range, `limit` to cap
 * entries. Read-only. Override the path with `path`.
 */
@complexity(allow)
fn __revision_log(harness: Harness, args: any) {
  const base = "/log" + __svn_repo_path(args)
  let query_parts = []
  if args?.from_revision != nil && trim(to_string(args.from_revision)) != "" {
    query_parts = query_parts + ["from=" + url_encode(to_string(args.from_revision))]
  }
  if args?.to_revision != nil && trim(to_string(args.to_revision)) != "" {
    query_parts = query_parts + ["to=" + url_encode(to_string(args.to_revision))]
  }
  if args?.limit != nil && trim(to_string(args.limit)) != "" {
    query_parts = query_parts + ["limit=" + url_encode(to_string(args.limit))]
  }
  const query = if len(query_parts) == 0 {
    ""
  } else {
    "?" + join(query_parts, "&")
  }
  const path = args?.path ?? (base + query)
  return __api_request(harness, args + {method: "GET", path: path})
}
